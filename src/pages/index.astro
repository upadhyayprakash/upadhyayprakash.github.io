---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import portrait from '../assets/portrait.png';
import portraitColor from '../assets/portrait-color.png';
import usptoSeal from '../assets/uspto-seal.png';
import medal from '../assets/riding/medal.jpg';
import race from '../assets/riding/race.jpg';
import sunrise from '../assets/riding/sunrise.jpg';
import roadside from '../assets/riding/roadside.jpg';
import wall from '../assets/riding/wall.jpg';
import parts from '../assets/riding/parts.jpg';

const now = [
  {
    meta: 'Product · Live',
    title: 'CertPulse',
    text: 'Certificate infrastructure for events. Import participant results, map them to branded templates, generate certificates in bulk, and give every recipient one they can verify by QR.',
    href: 'https://certpulse.revupulse.com',
    link: 'certpulse.revupulse.com',
  },
  {
    meta: 'Product · Beta',
    title: 'RevuPulse',
    text: 'The trust layer for modern discovery.',
    href: 'https://revupulse.com',
    link: 'revupulse.com',
  },
  {
    meta: 'Experiment',
    title: 'noui',
    text: "An open experiment in interfaces that form around what you're trying to do instead of making you learn them. Prototyping the interaction first, before putting a model behind it.",
    href: 'https://noui.si',
    link: 'noui.si',
  },
  {
    meta: 'Web standard · Filed 18 Oct 2026',
    title: 'HDR brightness preference',
    text: 'A proposed CSS user preference, like prefers-reduced-motion, so people can turn off sudden HDR brightness spikes.',
    href: 'https://github.com/w3c/csswg-drafts/issues/14616',
    link: 'w3c/csswg-drafts#14616',
  },
];

// Riding photos, cropped to 4:3. The slider fades through them; the first one shows without script.
const rides = [
  { image: medal, alt: 'The Bangalore Randonneurs medal for the Jog Falls 1000 km BRM, hanging in autumn light.' },
  { image: race, alt: 'Prakash racing as number 029 in the BBCh Race #02 individual time trial.' },
  { image: sunrise, alt: 'A rider\u2019s view over the handlebars, down a wide road at dawn.' },
  { image: roadside, alt: 'Prakash in helmet and race kit, standing astride his road bike on a sunny pavement.' },
  { image: wall, alt: 'A black road bike with two bottles and a saddle bag, leaning against a stone wall.' },
  { image: parts, alt: 'A road bike stripped down: frame, wheels, chainrings and small parts laid out on a tiled floor.' },
];

const wins = [
  { when: 'May 2025', what: 'Winner, QuillBot DevJam 2025: AI Writing Companion (ACE Chat)' },
  { when: 'Sep 2016', what: 'Winner (Logistics), SAP Global P&I IoT Challenge' },
  { when: 'Jun 2016', what: 'Winner, SAP sudoCODE 3.0' },
  { when: 'May 2016', what: 'Winner, SAP CodeForCharity' },
];
---

<Base
  title="Prakash Upadhyay · Full-stack engineer"
  description="Full-stack engineer with 10+ years across fintech and AI products. How I build software with AI agents, and keep a human in the loop."
  hand
  lens
>
  <section class="hero" aria-labelledby="hero-title" data-lens-zone>
    <div class="hero__inner container">
      <div class="hero__text">
        <div class="hero__intro">
          <p class="hero__links">
            <a href={site.github}><Icon name="github-solid" />GitHub</a>
            <a href={site.linkedin}><Icon name="linkedin-solid" />LinkedIn</a>
            <a class="hero__patent" href="#recognition"><Icon name="patent" />{site.patent.shortLabel}</a>
          </p>
        </div>
        <div class="hero__headline">
          <h1 id="hero-title">Prakash<br />Upadhyay<span class="dot" aria-hidden="true"></span></h1>
          <p class="hero__line">
            The <span class="human" data-lens-word>human<svg aria-hidden="true" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M0 6 C 12.5 2, 12.5 2, 25 6 S 37.5 10, 50 6 S 62.5 2, 75 6 S 87.5 10, 100 6 S 112.5 2, 125 6 S 137.5 10, 150 6 S 162.5 2, 175 6 S 187.5 10, 200 6" /></svg></span> in the loop of AI&#8209;driven software development.
          </p>
        </div>
        <div class="hero__actions">
          <a class="see-work" href="#now" data-lens-cta>See the work<span class="see-work__circle"><Icon name="chevron-right" size={16} /></span></a>
          <a class="resume" href={site.resumePdf} download="prakash_upadhyay_resume.pdf" aria-label="Download resume (PDF)" data-lens-cta>Download resume<Icon name="download" size={16} /></a>
        </div>
      </div>

      <div class="portrait" data-lens-portrait>
        <div class="portrait__frame" aria-hidden="true"></div>
        <Image src={portrait} quality={90} alt="Portrait of Prakash Upadhyay in a flat cap, smiling, turned to the right" loading="eager" fetchpriority="high" />
        <Image class="portrait__color" src={portraitColor} quality={90} alt="" aria-hidden="true" loading="eager" data-lens-color />
        <div class="hero__giant" aria-hidden="true" data-lens-giant>
          <svg viewBox="0 0 1000 240"><text x="0" y="232" textLength="1000" lengthAdjust="spacingAndGlyphs">Human</text></svg>
          <p class="label hero__giant-note">in the AI loop</p>
        </div>
        <p class="portrait__note" aria-hidden="true">research,<br />build,<br />review,<br />reuse.</p>
      </div>

      <nav class="counter label" aria-label="Page sections">
        <span class="counter__rule" aria-hidden="true"></span>
        <a href="#now" aria-label="Next section"><Icon name="chevron-down" size={20} /></a>
      </nav>
    </div>
  </section>
  <div class="lens" aria-hidden="true" data-lens></div>

  <section id="now" class="container block" aria-labelledby="now-title">
    <SectionLabel id="now-title" title="I'm currently working on" />
    <div class="now-grid">
      {now.map((card) => (
        <article class="card">
          <p class="meta">{card.meta}</p>
          <h3>{card.title}</h3>
          <p class="card__text">{card.text}</p>
          <a class="card__link" href={card.href}>{card.link}</a>
        </article>
      ))}
    </div>
  </section>

  <section id="recognition" class="container block" aria-labelledby="recognition-title">
    <SectionLabel id="recognition-title" title="Recognition" />
    <article class="patent" aria-labelledby="patent-title">
      <Image class="seal" src={usptoSeal} width={336} height={336} alt="Seal of the United States Patent and Trademark Office" />
      <div class="patent__body">
        <p class="meta">United States patent · Granted Mar 2021 · SAP Labs</p>
        <p class="patent__number">{site.patent.number}</p>
        <h3 id="patent-title">{site.patent.title}</h3>
        <p class="patent__text">A web UI framework that lets people use an app's elements and move between its screens by voice. It started as my winning SAP sudoCODE 3.0 hackathon project and was filed as a patent through SAP.</p>
        <a class="patent__link" href={site.patent.url}>Read the patent<Icon name="arrow-up-right" size={16} /></a>
      </div>
    </article>
    <div class="wins">
      <p class="meta">Hackathon wins</p>
      <ul>
        {wins.map((w) => (
          <li><span class="wins__when">{w.when}</span><span>{w.what}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="riding" class="container block" aria-labelledby="riding-title">
    <SectionLabel id="riding-title" title="Riding" />
    <div class="ride">
      <figure class="ride__photo" aria-roledescription="carousel" aria-label="Riding photos" data-ride>
        {rides.map((r, i) => (
          <Image
            class:list={['ride__slide', { 'is-on': i === 0 }]}
            src={r.image}
            alt={r.alt}
            data-slide
          />
        ))}
        <div class="ride__dots" role="group" aria-label="Choose a photo">
          {rides.map((r, i) => (
            <button type="button" aria-label={`Photo ${i + 1} of ${rides.length}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i}></button>
          ))}
        </div>
      </figure>
      <div class="ride__facts">
        <p class="meta">BRM</p>
        <div class="ride__stats">
          <p><span class="stat">1,000</span><span>kilometres</span></p>
          <p><span class="stat">73.5</span><span>hours</span></p>
        </div>
        <p class="ride__route">Bengaluru to Jog Falls and back.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  // The lens: a circle that follows a fine pointer and inverts what is under it.
  // "human" sits above the lens and turns rose while the lens overlaps it.
  // Over the portrait, the lens reveals the colour photo instead of inverting it.
  // The giant word "Human" is hidden until the lens passes over it.
  // "See the work" and "Download resume" become bordered buttons while the lens overlaps them.
  // It works over the hero, and over the pinned header only while part of the hero is still visible
  // below it; it hides anywhere else or on scroll.
  // Off for touch screens and for reduced motion; nothing on the page depends on it.
  const lens = document.querySelector<HTMLElement>('[data-lens]');
  const word = document.querySelector<HTMLElement>('[data-lens-word]');
  const portrait = document.querySelector<HTMLElement>('[data-lens-portrait]');
  const color = document.querySelector<HTMLElement>('[data-lens-color]');
  const giant = document.querySelector<HTMLElement>('[data-lens-giant]');
  const ctas = document.querySelectorAll<HTMLElement>('[data-lens-cta]');
  const hero = document.querySelector<HTMLElement>('.hero');
  const top = document.querySelector<HTMLElement>('[data-site-top]');
  const heroBelowHeader = () =>
    !!hero && !!top && hero.getBoundingClientRect().bottom > top.getBoundingClientRect().bottom;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const RADIUS = 100;

  const overlaps = (el: HTMLElement, e: PointerEvent) => {
    const b = el.getBoundingClientRect();
    const dx = Math.max(b.left - e.clientX, 0, e.clientX - b.right);
    const dy = Math.max(b.top - e.clientY, 0, e.clientY - b.bottom);
    return dx * dx + dy * dy < RADIUS * RADIUS;
  };

  const hide = () => {
    lens?.classList.remove('is-on');
    word?.classList.remove('is-lit');
    ctas.forEach((cta) => cta.classList.remove('is-framed'));
    if (color) {
      color.style.clipPath = '';
      color.classList.remove('is-on');
    }
    if (giant) {
      giant.style.clipPath = '';
      giant.classList.remove('is-on');
    }
  };

  if (lens && fine && !reduced) {
    document.addEventListener('pointermove', (e) => {
      const inZone = e.target instanceof Element && e.target.closest('[data-lens-zone]');
      if (!inZone || (inZone === top && !heroBelowHeader())) {
        hide();
        return;
      }
      lens.style.transform = `translate(${e.clientX - RADIUS}px, ${e.clientY - RADIUS}px)`;
      lens.classList.add('is-on');
      if (word) word.classList.toggle('is-lit', overlaps(word, e));
      ctas.forEach((cta) => cta.classList.toggle('is-framed', overlaps(cta, e)));
      if (portrait && color) {
        const p = portrait.getBoundingClientRect();
        color.style.clipPath = `circle(${RADIUS}px at ${e.clientX - p.left}px ${e.clientY - p.top}px)`;
        color.classList.add('is-on');
      }
      if (giant) {
        const g = giant.getBoundingClientRect();
        giant.style.clipPath = `circle(${RADIUS}px at ${e.clientX - g.left}px ${e.clientY - g.top}px)`;
        giant.classList.add('is-on');
      }
    });
    document.documentElement.addEventListener('pointerleave', hide);
    window.addEventListener('scroll', hide, { passive: true });
  }
</script>

<script>
  // Riding slider: fades to the next photo every few seconds while it is on screen. Hovering or
  // focusing it pauses; the dots jump to a photo. With reduced motion it never moves on its own.
  const ride = document.querySelector<HTMLElement>('[data-ride]');
  if (ride) {
    const slides = [...ride.querySelectorAll<HTMLImageElement>('[data-slide]')];
    const dots = [...ride.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let visible = false;
    let paused = false;
    const show = (n: number) => {
      const prev = slides[current];
      current = (n + slides.length) % slides.length;
      if (prev === slides[current]) return;
      // The outgoing photo keeps its zoom while it fades, instead of snapping back
      prev.style.transform = getComputedStyle(prev).transform;
      slides[current].style.transform = '';
      slides.forEach((s, i) => s.classList.toggle('is-on', i === current));
      dots.forEach((d, i) => {
        if (i === current) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
      // Load the next photo early so the fade never shows a blank frame
      slides[(current + 1) % slides.length].loading = 'eager';
    };
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    ride.addEventListener('pointerenter', () => (paused = true));
    ride.addEventListener('pointerleave', () => (paused = false));
    ride.addEventListener('focusin', () => (paused = true));
    ride.addEventListener('focusout', () => (paused = false));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.3 }).observe(ride);
    if (!reduced) {
      window.setInterval(() => {
        if (visible && !paused && !document.hidden) show(current + 1);
      }, 5000);
    }
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /* The giant word and its note sit just under the photo, at its width, and show only inside the lens */
  .hero__giant {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--outline);
    pointer-events: none;
    clip-path: circle(0 at 50% 50%);
  }

  /* The SVG scales the word to the photo's width */
  .hero__giant svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero__giant-note {
    margin: 0;
    align-self: flex-end;
    font-size: clamp(14px, 1.6vw, 20px);
    letter-spacing: 0.14em;
  }

  .hero__giant text {
    fill: currentColor;
    font-size: 296px;
    font-weight: 600;
  }

  /* Revealed only inside the lens: dark grey on the lens's light circle */
  .hero__giant.is-on {
    z-index: 31;
  }

  .hero__inner {
    position: relative;
    padding-top: 80px;
    padding-bottom: 196px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) 64px;
  }

  .hero__text {
    flex: 0 1 calc(50% - 32px);
    min-width: min(440px, 100%);
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero__eyebrow {
    margin: 0;
    color: var(--text-muted);
  }

  .hero__links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--size-small);
  }

  .hero__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    color: var(--text);
    text-decoration: none;
  }

  .hero__links a:hover {
    color: var(--ink);
  }

  /* The patent stands out in the light rose used for links on hover */
  .hero__links .hero__patent {
    color: var(--link-hover);
    font-weight: 600;
  }

  .hero__links .hero__patent:hover {
    color: var(--link-hover) !important;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h1 {
    margin: 0;
    font-size: var(--size-hero-name);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--display);
  }

  .dot {
    display: inline-block;
    width: 0.14em;
    height: 0.14em;
    border-radius: var(--radius-circle);
    background: var(--display);
    margin-left: 0.06em;
  }

  .hero__line {
    margin: 0;
    max-width: 30ch;
    font-size: var(--size-hero-line);
    line-height: 1.65;
    color: var(--text);
    text-wrap: balance;
  }

  .human {
    position: relative;
    z-index: 6;
    white-space: nowrap;
    color: var(--accent);
    font-weight: 600;
    transition: color 160ms ease-out;
  }

  .human.is-lit {
    z-index: 31;
    color: var(--lens-accent);
  }

  /* The underline is a wave twice as wide as the word, clipped to it; under the lens it flows sideways */
  .human svg {
    position: absolute;
    left: -2%;
    bottom: -0.32em;
    width: 104%;
    height: 0.42em;
    overflow: hidden;
  }

  .human.is-lit path {
    animation: human-wave 900ms linear infinite;
  }

  @keyframes human-wave {
    to { transform: translateX(-50px); }
  }

  .human path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) 36px;
  }

  /* The lens frames each action as a bordered button. The border is a drawn layer, so nothing shifts */
  .see-work,
  .resume {
    position: relative;
  }

  .see-work::before,
  .resume::before {
    content: '';
    position: absolute;
    top: 50%;
    height: 48px;
    transform: translateY(-50%);
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease-out;
  }

  .see-work::before {
    left: calc(-1 * var(--space-5));
    right: 0;
  }

  .resume::before {
    left: calc(-1 * var(--space-5));
    right: calc(-1 * var(--space-5));
  }

  .see-work.is-framed::before,
  .resume.is-framed::before {
    opacity: 1;
  }

  .see-work {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 48px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }

  .see-work__circle {
    width: var(--touch-target);
    height: var(--touch-target);
    border: 1px solid var(--accent);
    border-radius: var(--radius-circle);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 160ms ease-out;
  }

  .see-work:hover .see-work__circle {
    background: var(--surface-raised);
  }

  .see-work.is-framed .see-work__circle {
    border-color: transparent !important;
    background: transparent;
  }

  .resume {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    color: var(--text-muted);
    font-size: var(--size-small);
    text-decoration: none;
  }

  .resume:hover {
    color: var(--ink);
  }

  .resume :global(.p-drop) {
    transform-box: fill-box;
  }

  .resume:hover :global(.p-drop),
  .resume:focus-visible :global(.p-drop) {
    animation: drop 520ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes drop {
    0%, 100% { transform: translateY(0); }
    45% { transform: translateY(3px); }
  }

  /* Portrait: the frame sits behind the photo, so its lines stop where the photo starts */
  .portrait {
    flex: 0 1 500px;
    min-width: 300px;
    align-self: flex-end;
    position: relative;
    aspect-ratio: 784 / 670;
  }

  /* Left edge shared with the photo's left edge */
  .portrait__frame {
    position: absolute;
    left: 0;
    top: 4%;
    width: 60%;
    height: 82%;
    border: 5px solid var(--frame-accent);
  }

  .portrait img {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(180deg, #000 90%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 90%, transparent 100%);
  }

  /* The colour photo sits over the grey one and above the lens; only the lens circle shows it */
  .portrait .portrait__color {
    z-index: 6;
    clip-path: circle(0 at 50% 50%);
  }

  .portrait .portrait__color.is-on {
    z-index: 31;
  }

  .portrait__note {
    position: absolute;
    right: -8px;
    top: -6%;
    margin: 0;
    font-family: var(--font-hand);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    color: var(--text-muted);
    transform: rotate(-7deg);
  }

  .counter {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    width: var(--touch-target);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    font-size: var(--size-meta);
    color: var(--text-muted);
  }

  .counter > span:not(.counter__rule) {
    writing-mode: vertical-rl;
  }

  .counter__rule {
    width: 1px;
    height: 96px;
    background: var(--outline);
  }

  .counter a {
    width: var(--touch-target);
    height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
  }

  .lens {
    position: fixed;
    left: 0;
    top: 0;
    width: 200px;
    height: 200px;
    border-radius: var(--radius-circle);
    pointer-events: none;
    z-index: 30;
    -webkit-backdrop-filter: invert(1) grayscale(1);
    backdrop-filter: invert(1) grayscale(1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.35), 0 24px 60px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 180ms ease-out;
  }

  .lens.is-on {
    opacity: 1;
  }

  /* Sections */
  .block {
    padding-top: var(--space-11);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  #now {
    padding-top: var(--space-10);
  }

  .now-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: var(--space-4);
  }

  .card {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-radius: var(--radius-card);
  }

  .card h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--display);
  }

  .card__text {
    margin: 0;
    flex: 1;
