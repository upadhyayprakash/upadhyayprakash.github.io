---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { site } from '../data/site';

const now = [
  {
    meta: 'Product · Live',
    title: 'CertPulse',
    text: 'Certificate infrastructure for events. Import participant results, map them to branded templates, generate certificates in bulk, and give every recipient one they can verify by QR.',
    href: 'https://certpulse.revupulse.com',
    link: 'certpulse.revupulse.com',
  },
  {
    meta: 'Product · Beta',
    title: 'RevuPulse',
    text: 'The trust layer for modern discovery.',
    href: 'https://revupulse.com',
    link: 'revupulse.com',
  },
  {
    meta: 'Experiment',
    title: 'noui',
    text: "An open experiment in interfaces that form around what you're trying to do instead of making you learn them. Prototyping the interaction first, before putting a model behind it.",
    href: 'https://noui.si',
    link: 'noui.si',
  },
  {
    meta: 'Web standard · Filed 18 Oct 2026',
    title: 'HDR brightness preference',
    text: 'A proposed CSS user preference, like prefers-reduced-motion, so people can turn off sudden HDR brightness spikes.',
    href: 'https://github.com/w3c/csswg-drafts/issues/14616',
    link: 'w3c/csswg-drafts#14616',
  },
];

const wins = [
  { when: 'May 2025', what: '1st place, QuillBot DevJam 2025: AI Writing Companion (ACE Chat)' },
  { when: 'Sep 2016', what: 'Winner (Logistics), SAP Global P&I IoT Challenge' },
  { when: 'Jun 2016', what: 'Winner, SAP sudoCODE 3.0' },
  { when: 'May 2016', what: 'Winner, CodeForCharity SAP' },
];
---

<Base
  title="Prakash Upadhyay · Full-stack engineer"
  description="Full-stack engineer with 10+ years across fintech and AI products. How I build software with AI agents, and keep a human in the loop."
  hand
  lens
>
  <section class="hero" aria-labelledby="hero-title" data-lens-zone>
    <div class="hero__inner container">
      <div class="hero__text">
        <div class="hero__intro">
          <p class="label hero__eyebrow"><span>01</span> <span aria-hidden="true">/</span> <span>Home</span></p>
          <p class="hero__links">
            <a href={site.github}><Icon name="github" />GitHub</a>
            <a href={site.linkedin}><Icon name="linkedin" />LinkedIn</a>
            <a class="hero__patent" href="#recognition"><Icon name="patent" />{site.patent.shortLabel}</a>
          </p>
        </div>
        <div class="hero__headline">
          <h1 id="hero-title">Prakash<br />Upadhyay<span class="dot" aria-hidden="true"></span></h1>
          <p class="hero__line">
            The <span class="human" data-lens-word>human<svg aria-hidden="true" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M2 7 C 22 3, 48 9, 70 5 S 92 3, 98 6" /></svg></span> in the loop of AI&#8209;driven software development.
          </p>
        </div>
        <div class="hero__actions">
          <a class="see-work" href="#now">See the work<span class="see-work__circle"><Icon name="chevron-right" size={16} /></span></a>
          <a class="resume" href={site.resumePdf} download="prakash_upadhyay_resume.pdf" aria-label="Download resume (PDF)">Download resume<Icon name="download" size={16} /></a>
        </div>
      </div>

      <div class="portrait" data-lens-portrait>
        <div class="portrait__frame" aria-hidden="true"></div>
        <img src="/images/portrait.png" alt="Portrait of Prakash Upadhyay in a flat cap, smiling, turned to the right" width="784" height="670" />
        <img class="portrait__color" src="/images/portrait-color.png" alt="" aria-hidden="true" width="784" height="670" data-lens-color />
        <div aria-hidden="true" class="hero__giant" data-lens-giant>
          <svg viewBox="0 0 1000 240"><text x="0" y="232" textLength="1000" lengthAdjust="spacingAndGlyphs">Human</text></svg>
        </div>
        <p class="portrait__note" aria-hidden="true">research,<br />build,<br />review,<br />reuse.</p>
      </div>

      <nav class="counter label" aria-label="Page sections">
        <span>01</span>
        <span class="counter__rule" aria-hidden="true"></span>
        <span>03</span>
        <a href="#now" aria-label="Next section"><Icon name="chevron-down" size={20} /></a>
      </nav>
    </div>
  </section>
  <div class="lens" aria-hidden="true" data-lens></div>

  <section id="now" class="container block" aria-labelledby="now-title">
    <SectionLabel id="now-title" num="01" title="I'm currently working on" />
    <div class="now-grid">
      {now.map((card) => (
        <article class="card">
          <p class="meta">{card.meta}</p>
          <h3>{card.title}</h3>
          <p class="card__text">{card.text}</p>
          <a class="card__link" href={card.href}>{card.link}</a>
        </article>
      ))}
    </div>
  </section>

  <section id="recognition" class="container block" aria-labelledby="recognition-title">
    <SectionLabel id="recognition-title" num="02" title="Recognition" />
    <article class="patent" aria-labelledby="patent-title">
      <div class="badge" role="img" aria-label="Granted by the United States Patent and Trademark Office">
        <span class="badge__ring" aria-hidden="true"></span>
        <Icon name="patent" size={34} />
        <span class="badge__word" aria-hidden="true">USPTO</span>
        <span class="badge__year" aria-hidden="true">Granted 2021</span>
      </div>
      <div class="patent__body">
        <p class="meta">United States patent · Granted Mar 2021 · SAP Labs</p>
        <p class="patent__number">{site.patent.number}</p>
        <h3 id="patent-title">{site.patent.title}</h3>
        <p class="patent__text">A web UI framework that lets people use an app's elements and move between its screens by voice. It started as my winning SAP sudoCODE 3.0 hackathon project and was filed as a patent through SAP.</p>
        <a class="patent__link" href={site.patent.url}>Read the patent<Icon name="arrow-up-right" size={16} /></a>
      </div>
    </article>
    <div class="wins">
      <p class="meta">Hackathon wins</p>
      <ul>
        {wins.map((w) => (
          <li><span class="wins__when">{w.when}</span><span>{w.what}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="riding" class="container block" aria-labelledby="riding-title">
    <SectionLabel id="riding-title" num="03" title="Riding" />
    <div class="ride">
      <figure class="ride__photo">
        <img src="/images/ride-stand-in.jpg" alt="A lone cyclist on a long road through green alpine meadows, mountains ahead. Stand-in photo." width="1920" height="1280" loading="lazy" />
        <figcaption>Stand-in photo · Jana Jedinak, CC0</figcaption>
      </figure>
      <div class="ride__facts">
        <p class="meta">BRM · [year]</p>
        <div class="ride__stats">
          <p><span class="stat">1,000</span><span>kilometres</span></p>
          <p><span class="stat">73.5</span><span>hours</span></p>
        </div>
        <p class="ride__route">Bengaluru to Jog Falls and back.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  // The lens: a circle that follows a fine pointer and inverts what is under it.
  // "human" sits above the lens and turns pastel orange while the lens overlaps it.
  // Over the portrait, the lens reveals the colour photo instead of inverting it.
  // The giant word "Human" is hidden until the lens passes over it.
  // It works over the hero, and over the pinned header only while part of the hero is still visible
  // below it; it hides anywhere else or on scroll.
  // Off for touch screens and for reduced motion; nothing on the page depends on it.
  const lens = document.querySelector<HTMLElement>('[data-lens]');
  const word = document.querySelector<HTMLElement>('[data-lens-word]');
  const portrait = document.querySelector<HTMLElement>('[data-lens-portrait]');
  const color = document.querySelector<HTMLElement>('[data-lens-color]');
  const giant = document.querySelector<HTMLElement>('[data-lens-giant]');
  const hero = document.querySelector<HTMLElement>('.hero');
  const top = document.querySelector<HTMLElement>('[data-site-top]');
  const heroBelowHeader = () =>
    !!hero && !!top && hero.getBoundingClientRect().bottom > top.getBoundingClientRect().bottom;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const RADIUS = 100;

  const hide = () => {
    lens?.classList.remove('is-on');
    word?.classList.remove('is-lit');
    if (color) {
      color.style.clipPath = '';
      color.classList.remove('is-on');
    }
    if (giant) {
      giant.style.clipPath = '';
      giant.classList.remove('is-on');
    }
  };

  if (lens && fine && !reduced) {
    document.addEventListener('pointermove', (e) => {
      const inZone = e.target instanceof Element && e.target.closest('[data-lens-zone]');
      if (!inZone || (inZone === top && !heroBelowHeader())) {
        hide();
        return;
      }
      lens.style.transform = `translate(${e.clientX - RADIUS}px, ${e.clientY - RADIUS}px)`;
      lens.classList.add('is-on');
      if (word) {
        const b = word.getBoundingClientRect();
        const dx = Math.max(b.left - e.clientX, 0, e.clientX - b.right);
        const dy = Math.max(b.top - e.clientY, 0, e.clientY - b.bottom);
        word.classList.toggle('is-lit', dx * dx + dy * dy < RADIUS * RADIUS);
      }
      if (portrait && color) {
        const p = portrait.getBoundingClientRect();
        color.style.clipPath = `circle(${RADIUS}px at ${e.clientX - p.left}px ${e.clientY - p.top}px)`;
        color.classList.add('is-on');
      }
      if (giant) {
        const g = giant.getBoundingClientRect();
        giant.style.clipPath = `circle(${RADIUS}px at ${e.clientX - g.left}px ${e.clientY - g.top}px)`;
        giant.classList.add('is-on');
      }
    });
    document.documentElement.addEventListener('pointerleave', hide);
    window.addEventListener('scroll', hide, { passive: true });
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /* Spans the photo's width and sits just under it; the SVG scales the word to fit */
  .hero__giant {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    width: 100%;
    color: var(--outline);
    pointer-events: none;
    clip-path: circle(0 at 50% 50%);
  }

  .hero__giant svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero__giant text {
    fill: currentColor;
    font-size: 296px;
    font-weight: 600;
  }

  /* Revealed only inside the lens: dark grey on the lens's light circle */
  .hero__giant.is-on {
    z-index: 31;
  }

  .hero__inner {
    position: relative;
    padding-top: 80px;
    padding-bottom: 160px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) 64px;
  }

  .hero__text {
    flex: 0 1 calc(50% - 32px);
    min-width: min(440px, 100%);
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero__eyebrow {
    margin: 0;
    color: var(--text-muted);
  }

  .hero__links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--size-small);
  }

  .hero__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    color: var(--text);
    text-decoration: none;
  }

  .hero__links a:hover {
    color: var(--ink);
  }

  .hero__links .hero__patent {
    color: var(--accent);
    font-weight: 600;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h1 {
    margin: 0;
    font-size: var(--size-hero-name);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .dot {
    display: inline-block;
    width: 0.14em;
    height: 0.14em;
    border-radius: var(--radius-circle);
    background: var(--accent);
    margin-left: 0.06em;
  }

  .hero__line {
    margin: 0;
    max-width: 30ch;
    font-size: var(--size-hero-line);
    line-height: 1.65;
    color: var(--text);
    text-wrap: balance;
  }

  .human {
    position: relative;
    z-index: 6;
    white-space: nowrap;
    color: var(--accent);
    font-weight: 600;
    transition: color 160ms ease-out;
  }

  .human.is-lit {
    z-index: 31;
    color: var(--lens-accent);
  }

  .human svg {
    position: absolute;
    left: -2%;
    bottom: -0.32em;
    width: 104%;
    height: 0.42em;
    overflow: visible;
  }

  .human path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) 36px;
  }

  .see-work {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 48px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }

  .see-work__circle {
    width: var(--touch-target);
    height: var(--touch-target);
    border: 1px solid var(--accent);
    border-radius: var(--radius-circle);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 160ms ease-out;
  }

  .see-work:hover .see-work__circle {
    background: var(--surface-raised);
  }

  .resume {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    color: var(--text-muted);
    font-size: var(--size-small);
    text-decoration: none;
  }

  .resume:hover {
    color: var(--ink);
  }

  .resume :global(.p-drop) {
    transform-box: fill-box;
  }

  .resume:hover :global(.p-drop),
  .resume:focus-visible :global(.p-drop) {
    animation: drop 520ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes drop {
    0%, 100% { transform: translateY(0); }
    45% { transform: translateY(3px); }
  }

  /* Portrait: the frame sits behind the photo, so its lines stop where the photo starts */
  .portrait {
    flex: 0 1 500px;
    min-width: 300px;
    align-self: flex-end;
    position: relative;
    aspect-ratio: 784 / 670;
  }

  .portrait__frame {
    position: absolute;
    left: 2%;
    top: 4%;
    width: 60%;
    height: 82%;
    border: 1.5px solid var(--frame-accent);
  }

  .portrait img {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(180deg, #000 90%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 90%, transparent 100%);
  }

  /* The colour photo sits over the grey one and above the lens; only the lens circle shows it */
  .portrait .portrait__color {
    z-index: 6;
    clip-path: circle(0 at 50% 50%);
  }

  .portrait .portrait__color.is-on {
    z-index: 31;
  }

  .portrait__note {
    position: absolute;
    right: -8px;
    top: -6%;
    margin: 0;
    font-family: var(--font-hand);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    color: var(--text-muted);
    transform: rotate(-7deg);
  }

  .counter {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    width: var(--touch-target);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    font-size: var(--size-meta);
    color: var(--text-muted);
  }

  .counter > span:not(.counter__rule) {
    writing-mode: vertical-rl;
  }

  .counter__rule {
    width: 1px;
    height: 96px;
    background: var(--outline);
  }

  .counter a {
    width: var(--touch-target);
    height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
  }

  .lens {
    position: fixed;
    left: 0;
    top: 0;
    width: 200px;
    height: 200px;
    border-radius: var(--radius-circle);
    pointer-events: none;
    z-index: 30;
    -webkit-backdrop-filter: invert(1) grayscale(1);
    backdrop-filter: invert(1) grayscale(1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.35), 0 24px 60px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 180ms ease-out;
  }

  .lens.is-on {
    opacity: 1;
  }

  /* Sections */
  .block {
    padding-top: var(--space-11);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  #now {
    padding-top: var(--space-10);
  }

  .now-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: var(--space-4);
  }

  .card {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .card__text {
    margin: 0;
    flex: 1;
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  .card__link {
    font-size: var(--size-small);
    text-underline-offset: 4px;
    padding: var(--space-2) 0;
  }

  /* Patent */
  .patent {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 56px;
  }

  .badge {
    flex: 0 0 168px;
    width: 168px;
    height: 168px;
    border-radius: var(--radius-circle);
    border: 1.5px solid var(--accent);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--accent);
  }

  .badge__ring {
    position: absolute;
    inset: 8px;
    border-radius: var(--radius-circle);
    border: 1px dashed var(--outline);
  }

  .badge__word {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .badge__year {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .patent__body {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .patent__number {
    margin: 0;
    color: var(--accent);
    font-size: clamp(48px, 6.4vw, 88px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .patent h3 {
    margin: 0;
    color: var(--accent);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .patent__text {
    margin: 0;
    max-width: 620px;
    font-size: 16px;
  }

  .patent__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    font-size: var(--size-small);
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
  }

  .wins ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }

  .wins li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }

  .wins__when {
    width: 96px;
    font-size: 14px;
    color: var(--text-muted);
  }

  /* Riding */
  .ride {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-8);
  }

  .ride__photo {
    flex: 1 1 420px;
    margin: 0;
    position: relative;
    border: 1px solid var(--line);
  }

  .ride__photo img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 300px;
    object-fit: cover;
  }

  .ride__photo figcaption {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    background: var(--bg);
    color: var(--text-muted);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px var(--space-2);
  }

  .ride__facts {
    flex: 1 1 380px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }

  .ride__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-8);
  }

  .ride__stats p {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  .stat {
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
  }

  .ride__route {
    margin: 0;
    font-size: 19px;
  }

  /* Phone */
  @media (max-width: 760px) {
    .hero__inner {
      padding-top: var(--space-8);
      padding-bottom: 160px;
    }

    .hero__text {
      flex-basis: 100%;
    }

    .portrait {
      flex-basis: 100%;
      min-width: 0;
    }

    .portrait__note {
      right: 0;
    }

    .counter {
      display: none;
    }
  }
</style>
