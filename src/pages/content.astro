---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { entries, types } from '../data/content';

const single = Object.fromEntries(types.map((t) => [t.id, t.single]));
const years = [...new Set(entries.map((e) => e.year))];
const count = (id: string) => entries.filter((e) => id === 'all' || e.type === id).length;
// Only types with at least one entry get a filter; empty types stay hidden until a link arrives
const filters = [{ id: 'all', label: 'All' }, ...types.filter((t) => count(t.id) > 0)];
---

<Base title="Content, Prakash Upadhyay" description="Posts, videos, articles and carousels by Prakash Upadhyay on LinkedIn.">
  <section class="title-area" aria-labelledby="page-title">
    <div class="container title-area__inner">
      <h1 id="page-title">Content</h1>
      <p class="tagline">Posts. Videos. Articles.</p>
      <p class="intro">Everything I share on LinkedIn (posts, videos, articles and carousels), kept here with a thumbnail and a link to the original.</p>
      <a class="follow" href="https://www.linkedin.com/in/upadhyayprakash/recent-activity/all/">Follow on LinkedIn<Icon name="arrow-up-right" size={16} /></a>
    </div>
  </section>

  <div class="container log" data-content-log>
    <div class="log__bar">
      <div class="chips" role="group" aria-label="Filter by type">
        {filters.map((f, i) => (
          <button type="button" class="chip" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}<span class="chip__count">{count(f.id)}</span>
          </button>
        ))}
      </div>
      <p class="log__summary" aria-live="polite" data-summary>{entries.length} {entries.length === 1 ? 'entry' : 'entries'} logged</p>
    </div>

    {years.map((year) => (
      <section class="group" aria-label={year} data-group>
        <div class="group__label">
          <h2 class="section-title">{year}</h2>
          <div class="group__rule" aria-hidden="true"></div>
        </div>
        <div class="rows">
          {entries.filter((e) => e.year === year).map((e) => (
            <article class="row" data-type={e.type}>
              {e.thumb ? (
                <div class="row__art">
                  <img src={e.thumb} alt={e.thumbAlt ?? ''} loading="lazy" />
                  {e.thumbNote && <span class="row__note">{e.thumbNote}</span>}
                </div>
              ) : (
                <div class="row__art placeholder" aria-hidden="true">[Thumbnail]</div>
              )}
              <div class="row__body">
                <p class="meta"><span class="row__type">{single[e.type]}</span><span>{e.date}</span></p>
                <h3>{e.slug ? <a href={`/content/${e.slug}`}>{e.title}</a> : e.title}</h3>
                <p class="row__tags">{e.tags}</p>
                <a class="row__link" href={e.url}>View on LinkedIn<Icon name="arrow-up-right" size={16} /></a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

  </div>
</Base>

<script>
  // Filter by type: hide rows of other types, and any group left empty. Without script, everything shows.
  const log = document.querySelector<HTMLElement>('[data-content-log]');
  if (log) {
    const buttons = [...log.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const summary = log.querySelector<HTMLElement>('[data-summary]');
    const apply = (id: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === id)));
      let real = 0;
      log.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
        let shown = 0;
        group.querySelectorAll<HTMLElement>('[data-type]').forEach((row) => {
          const on = id === 'all' || row.dataset.type === id;
          row.hidden = !on;
          if (on) {
            shown += 1;
            real += 1;
          }
        });
        group.hidden = shown === 0;
      });
      if (summary) summary.textContent = `${real} ${real === 1 ? 'entry' : 'entries'} logged`;
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
  }
</script>

<style>
  .title-area {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .title-area__inner {
    padding-top: var(--space-9);
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .eyebrow {
    margin: 0;
    color: var(--text-muted);
  }

  h1 {
    margin: 0;
    color: var(--display);
    font-size: var(--size-page-title);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .tagline {
    margin: 0;
    font-size: var(--size-tagline);
    font-weight: 300;
    color: var(--text-muted);
  }

  .intro {
    margin: 0;
    max-width: 680px;
    font-size: 19px;
    text-wrap: pretty;
  }

  .follow {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    font-size: var(--size-small);
    font-weight: 600;
    text-decoration: none;
  }

  .log {
    padding-top: 56px;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .log__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    min-height: var(--touch-target);
    padding: 0 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--control-border);
    background: transparent;
    color: var(--ink);
    font: 500 var(--size-small) / 1 var(--font-sans);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .chip__count {
    font-size: var(--size-meta);
    color: var(--text-muted);
  }

  .chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .chip[aria-pressed='true'] .chip__count {
    color: var(--line-strong);
  }

  .chip:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .log__summary {
    margin: 0;
    font-size: var(--size-label);
    color: var(--text-muted);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .group__label {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .group__rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .row {
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px var(--space-7);
    padding: var(--space-6) 0;
  }

  .row[hidden],
  .group[hidden] {
    display: none;
  }

  .row__art {
    position: relative;
    flex: 0 0 300px;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }

  .row__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
  }

  .row__note {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    background: var(--bg);
    color: var(--text-muted);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px var(--space-2);
    font-weight: var(--weight-label);
  }

  .row__body {
    flex: 1 1 360px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .row .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .row__type {
    color: var(--ink);
  }

  .row h3 {
    margin: 0;
    color: var(--accent);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }


  .row__tags {
    margin: 0;
    font-size: 14px;
    color: var(--text-muted);
  }

  .row__link {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch-target);
    font-size: var(--size-small);
    font-weight: 500;
    text-decoration: none;
  }
</style>
