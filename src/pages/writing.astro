<Base title="Writing, Prakash Upadhyay" description="Articles by Prakash Upadhyay on building software, AI tools and the web." current="writing">
<section aria-labelledby="page-title" style="position: relative; overflow: hidden; border-bottom: 1px solid var(--line); background: radial-gradient(900px 520px at 22% 30%, var(--hero-glow) 0%, var(--hero-mid) 55%, var(--bg) 100%)">
<div style="position: relative; max-width: 1200px; margin: 0 auto; padding: 72px clamp(16px, 4vw, 40px) 80px; display: flex; flex-direction: column; gap: 24px">
<h1 id="page-title" style="margin: 0; color: var(--accent); font-size: clamp(48px, 7vw, 96px); font-weight: 500; letter-spacing: -0.035em; line-height: 0.98">Writing</h1>
<p style="margin: 0; font-size: clamp(22px, 2.6vw, 30px); font-weight: 300; color: var(--text-muted)">Notes. Builds. Lessons.</p>
<p style="margin: 0; max-width: 640px; font-size: 18px; color: var(--text)">Longer pieces on what I build and how. Short posts and videos live on the <a href="/content" style="color: var(--ink); text-underline-offset: 4px">Content</a> page.</p>
</div>
</section>

