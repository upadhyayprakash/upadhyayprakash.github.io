---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={`${post.data.title}, Prakash Upadhyay`} description={post.data.description} current="writing">
  <article class="article container">
    <header class="article__head">
      <nav class="label crumbs" aria-label="Breadcrumb">
        <span>02</span><span aria-hidden="true">/</span><a href="/writing">Writing</a>
      </nav>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time>
        <span aria-hidden="true">·</span>
        <span>{post.data.tags.join(' · ')}</span>
      </p>
      {post.data.heroImage && <img class="article__hero" src={post.data.heroImage} alt="" width="1200" height="630" />}
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/writing">All writing</a></p>
  </article>
</Base>

<style>
  .article {
    padding-top: var(--space-9);
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }

  .article__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .crumbs {
    display: flex;
    gap: 10px;
    color: var(--text-muted);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  h1 {
    margin: 0;
    color: var(--accent);
    font-size: clamp(32px, 4.4vw, 52px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .article .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .article__hero {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-4);
    border: 1px solid var(--line);
  }

  .prose {
    font-size: var(--size-body);
    line-height: 1.75;
  }

  .prose :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
    color: var(--ink);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .prose :global(h3) {
    margin: var(--space-7) 0 var(--space-2);
    color: var(--ink);
    font-size: 21px;
    font-weight: 500;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-4);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(a) {
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(blockquote) {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--accent);
    background: var(--surface);
    color: var(--text);
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-5) 0 var(--space-2);
    border: 1px solid var(--line);
  }

  .prose :global(em) {
    color: var(--text-muted);
  }

  .prose :global(code) {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.88em;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    color: var(--ink);
  }

  .prose :global(pre) {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--letterbox) !important;
    font-size: 14px;
    line-height: 1.6;
  }

  /* Long inline identifiers wrap on narrow screens; code blocks scroll instead */
  .prose :global(:not(pre) > code) {
    overflow-wrap: anywhere;
  }

  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-5) 0;
    font-size: var(--size-small);
    display: block;
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
  }

  .prose :global(th) {
    color: var(--text-muted);
    font-weight: 500;
  }

  .back {
    margin-top: var(--space-8);
  }
</style>
