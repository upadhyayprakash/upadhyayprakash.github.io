<div aria-hidden="true" style="flex: 1; height: 1px; background: var(--line)"></div>
</div>
<ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column">
<li style="border-top: 1px solid var(--line)">
<a class="card-link" href="/work/noui" style="color: inherit; text-decoration: none; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; padding: 28px 0">
