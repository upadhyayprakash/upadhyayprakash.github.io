---
import Base from '../../layouts/Base.astro';
import { featured, projects } from '../../data/projects';

const chip = 'border: 1px solid var(--line-strong); border-radius: 999px; padding: 3px 10px; font-family: var(--font-label); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted)';
const ext = 'M7 17L17 7 M8 7h9v9';
---

<Base title="Work, Prakash Upadhyay" description="Selected work by Prakash Upadhyay: noui.si, CertPulse, the HDR brightness preference, open-source projects like PlayUI and work at Gojek, Paytm Insider and QuillBot." current="work">
<section aria-labelledby="page-title" style="position: relative; overflow: hidden; border-bottom: 1px solid var(--line); background: radial-gradient(900px 520px at 22% 30%, var(--hero-glow) 0%, var(--hero-mid) 55%, var(--bg) 100%)">
<div style="position: relative; max-width: 1200px; margin: 0 auto; padding: 72px clamp(16px, 4vw, 40px) 80px; display: flex; flex-direction: column; gap: 24px">
<h1 id="page-title" style="margin: 0; color: var(--accent); font-size: clamp(48px, 7vw, 96px); font-weight: 500; letter-spacing: -0.035em; line-height: 0.98">Work</h1>
<p style="margin: 0; font-size: clamp(22px, 2.6vw, 30px); font-weight: 300; color: var(--text-muted)">Products. Standards. Systems.</p>
<p style="margin: 0; max-width: 640px; font-size: 18px; color: var(--text)">What I am building now, what I have proposed, and what I shipped inside companies.</p>
</div>
</section>

<main style="max-width: 1200px; margin: 0 auto; padding: 96px clamp(16px, 4vw, 40px) 0; display: flex; flex-direction: column; gap: 120px">
