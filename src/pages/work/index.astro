<li style="border-top: 1px solid var(--line); border-bottom: 1px solid var(--line)">
<div style="display: flex; flex-wrap: wrap; gap: 6px 24px; padding: 22px 0; color: inherit; text-decoration: none">
<span style="font-family: var(--font-label); font-size: 14px; color: var(--accent); width: 28px; padding-top: 3px">04</span>
