<script>
  // Skill table filter: Global, Project or all. Without script, every row shows.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-scope].scope-chip')];
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-scope]')];
  const summary = document.querySelector<HTMLElement>('[data-skill-summary]');
  const text: Record<string, string> = {
    all: '15 skills, plus Launchpad\u2019s 13',
    global: '10 global skills',
    project: '5 project skills',
  };
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const scope = chip.dataset.scope ?? 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      rows.forEach((r) => (r.hidden = scope !== 'all' && r.dataset.scope !== scope));
      if (summary) summary.textContent = text[scope];
    }),
  );
</script>

<script>
  // Loop stage labels: a splash shape sits behind each name (shown on hover and focus), and a
  // tooltip says what I decide at that stage. Each name links to its entry below.
  const loop = document.querySelector<HTMLElement>('[data-loop]');
  const tip = document.querySelector<HTMLElement>('[data-loop-tip]');
  const stageLinks = [...document.querySelectorAll<SVGAElement>('.loop-stage')];

  // A closed, wobbly blob around a box, with a few spikes so it reads as a splash.
  // Seeded per label, so it looks the same on every visit.
  const splash = (x: number, y: number, w: number, h: number, seed: number) => {
    let n = seed;
    const rand = () => ((n = (n * 9301 + 49297) % 233280) / 233280);
    const cx = x + w / 2, cy = y + h / 2, rx = w / 2 + 18, ry = h / 2 + 12;
    const pts = Array.from({ length: 18 }, (_, i) => {
      const a = (i / 18) * Math.PI * 2;
      const r = i % 6 === 2 ? 1.22 + rand() * 0.1 : 0.9 + rand() * 0.16;
      return [cx + Math.cos(a) * rx * r, cy + Math.sin(a) * ry * r];
    });
    const at = (i: number) => pts[(i + pts.length) % pts.length];
    let d = `M ${at(0)[0].toFixed(1)} ${at(0)[1].toFixed(1)}`;
    for (let i = 0; i < pts.length; i++) {
      const [p0, p1, p2, p3] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
      const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
      const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
      d += ` C ${c1[0].toFixed(1)} ${c1[1].toFixed(1)}, ${c2[0].toFixed(1)} ${c2[1].toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
    }
    return d + ' Z';
  };

  const drawSplashes = () =>
    stageLinks.forEach((a, i) => {
      const text = a.querySelector('text');
      const path = a.querySelector('.loop-stage__splash');
      if (!text || !path) return;
      const b = text.getBBox();
      path.setAttribute('d', splash(b.x, b.y, b.width, b.height, 7 + i * 13));
    });
  document.fonts.ready.then(drawSplashes);

  const showTip = (a: SVGAElement) => {
    if (!loop || !tip) return;
    tip.textContent = a.dataset.tip ?? '';
    tip.hidden = false;
    const box = loop.getBoundingClientRect();
    const r = (a.querySelector('text') ?? a).getBoundingClientRect();
    const left = Math.min(Math.max(r.left + r.width / 2 - box.left - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth);
    tip.style.left = `${left}px`;
    tip.style.top = `${r.top - box.top - tip.offsetHeight - 14}px`;
  };
  const hideTip = () => tip && (tip.hidden = true);
  stageLinks.forEach((a) => {
    a.addEventListener('pointerenter', () => showTip(a));
    a.addEventListener('focus', () => showTip(a));
    a.addEventListener('pointerleave', hideTip);
    a.addEventListener('blur', hideTip);
    a.addEventListener('click', hideTip);
  });
</script>

<style is:global>
  code {
    font-family: var(--font-sans);
    font-size: 0.88em;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    color: var(--ink);
  }

  /* The loop draws itself in once; with reduced motion it is simply there */
  .loop-draw {
    stroke-dashoffset: 0;
    animation: loop-draw 2200ms ease-in-out both;
  }

  @keyframes loop-draw {
    from { stroke-dashoffset: 1500; }
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-draw { animation: none; }
  }

  .scope-chip {
    min-height: var(--touch-target);
    padding: 0 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--control-border);
    background: transparent;
    color: var(--ink);
    font: 500 var(--size-small) / 1 var(--font-sans);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .scope-chip__count {
    font-size: var(--size-meta);
    color: var(--text-muted);
  }

  .scope-chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .scope-chip[aria-pressed='true'] .scope-chip__count {
    color: var(--line-strong);
  }

  .scope-chip:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  tr[hidden] {
    display: none;
  }

  /* Loop stage names: a splash behind on hover and focus, a tooltip above */
  .loop {
    position: relative;
  }

  .loop-stage {
    cursor: pointer;
    outline: none;
  }

  .loop-stage text {
    transition: fill 160ms ease-out;
  }

  .loop-stage__splash {
    fill: var(--link-hover);
    fill-opacity: 0.14;
    stroke: var(--link-hover);
    stroke-width: 1.4;
    opacity: 0;
    transform: scale(0.6);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 160ms ease-out, transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1);
