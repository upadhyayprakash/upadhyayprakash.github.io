---
import Icon from './Icon.astro';
import ContactDialog from './ContactDialog.astro';
import { site } from '../data/site';
---

<footer class="site-footer container">
  <a class="sign-off" href={`mailto:${site.email}`} aria-haspopup="dialog" data-contact-open>
    Let's build something great
    <span class="sign-off__circle"><Icon name="arrow-right" /></span>
  </a>
  <div class="site-footer__row">
    <a href="/">{site.name}</a>
    <div class="site-footer__links">
      <a href="/content">Content</a>
      <a href={site.resumePdf} download="prakash_upadhyay_resume.pdf">Resume (PDF)</a>
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.linkedin}>LinkedIn</a>
    </div>
  </div>
  <ContactDialog />
</footer>

<style>
  .site-footer {
    padding-top: 140px;
    padding-bottom: 56px;
  }

  .sign-off {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 56px;
    color: var(--display);
    text-decoration: none;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .sign-off__circle {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-circle);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 160ms ease-out;
  }

  .sign-off:hover .sign-off__circle {
    background: var(--surface-raised);
  }

  .sign-off :global(svg) {
    transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .sign-off:hover :global(svg),
  .sign-off:focus-visible :global(svg) {
    transform: translateX(3px);
  }

  .site-footer__row {
    border-top: 1px solid var(--line-strong);
    padding-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4) 32px;
    font-size: var(--size-small);
  }

  .site-footer__row a {
    text-underline-offset: 4px;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .site-footer__links a {
    color: var(--text-muted);
  }

  .site-footer__links a:hover {
    color: var(--ink);
  }
</style>
