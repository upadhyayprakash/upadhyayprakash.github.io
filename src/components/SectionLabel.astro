---
// A section's title and a hairline that runs to the edge.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="section-label">
  <h2 id={id} class="label">{title}</h2>
  <div class="rule" aria-hidden="true"></div>
</div>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  h2 {
    margin: 0;
    display: flex;
    gap: 14px;
    font-weight: 500;
    color: var(--ink);
  }

  .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
</style>
